{
  "name": "@ccn/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:seed": "bun run src/seed.ts",
    "db:seed:reference": "bun run src/seed.ts --reference-only"
  },
  "dependencies": {
    "drizzle-orm": "0.44.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "bun-types": "1.3.11",
    "drizzle-kit": "0.31.1",
    "typescript": "5.6.3"
  }
}
