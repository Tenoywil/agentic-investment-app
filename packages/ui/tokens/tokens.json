{
  "$schema": "https://tr.designtokens.org/format/tokens.schema.json",
  "$description": "CCN design tokens (W3C DTCG). Primitive -> semantic. rem-based type + spacing scale everything from the root font-size; built for a 35+ audience.",
  "color": {
    "brand": {
      "teal900": { "$type": "color", "$value": "#0b201d" },
      "teal800": { "$type": "color", "$value": "#0e2c28" },
      "teal700": { "$type": "color", "$value": "#124e48" },
      "teal600": { "$type": "color", "$value": "#0e5952" },
      "green500": { "$type": "color", "$value": "#0a8f5b" },
      "cream50": { "$type": "color", "$value": "#fdfcfa" },
      "cream100": { "$type": "color", "$value": "#f4f0e7" },
      "cream200": { "$type": "color", "$value": "#e4e0d6" },
      "terra500": { "$type": "color", "$value": "#c56a3e" },
      "gold500": { "$type": "color", "$value": "#d9a441" }
    },
    "ink": {
      "900": { "$type": "color", "$value": "#12332e" },
      "500": { "$type": "color", "$value": "#5c5449" }
    },
    "semantic": {
      "bg": { "$type": "color", "$value": "{color.brand.cream100}" },
      "surface": { "$type": "color", "$value": "{color.brand.cream50}" },
      "text": { "$type": "color", "$value": "{color.ink.900}" },
      "textMuted": { "$type": "color", "$value": "{color.ink.500}" },
      "primary": { "$type": "color", "$value": "{color.brand.teal700}" },
      "focus": { "$type": "color", "$value": "{color.brand.teal600}" }
    }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["Hanken Grotesk", "system-ui", "sans-serif"] },
    "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Georgia", "serif"] },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "0.875rem" },
    "body": { "$type": "dimension", "$value": "1rem" },
    "bodyLg": { "$type": "dimension", "$value": "1.125rem" },
    "title": { "$type": "dimension", "$value": "1.5rem" },
    "heading": { "$type": "dimension", "$value": "1.875rem" },
    "display": { "$type": "dimension", "$value": "2.75rem" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" }
  },
  "size": {
    "targetMin": {
      "$type": "dimension",
      "$value": "3rem",
      "$description": "48px at Comfortable base; scales with root"
    }
  },
  "uiScale": {
    "base": { "$type": "number", "$value": 1.125, "$description": "Comfortable = 18px" },
    "lg": { "$type": "number", "$value": 1.25, "$description": "Large = 20px" },
    "xl": { "$type": "number", "$value": 1.375, "$description": "Larger = 22px" },
    "xxl": { "$type": "number", "$value": 1.5, "$description": "Largest = 24px" }
  }
}
