{
  "name": "caribbean-capital-network",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "workspaces": ["apps/*", "packages/*"],
  "//overrides": "Pin one React 19 type surface across the monorepo so packages authored against @types/react 18 (e.g. @ccn/ui) match the Next 15 app.",
  "overrides": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "lefthook": "1.8.2",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  }
}
