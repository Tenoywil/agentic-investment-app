# CCN environment contract — copy to .env.local for local dev; real values come from Doppler.
# Never commit real secrets. packages/config validates all of these at startup (fail-fast).

# --- Runtime ---
APP_ENV=development                     # development | staging | production
NODE_ENV=development
PORT=3001                               # Bun + Hono API port

# --- Database (Supabase Postgres, us-east-1) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ccn
DB_APP_ROLE=ccn_app                     # non-superuser role the request tx drops to (RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=ccn-private

# --- Auth (Better Auth + Google) ---
BETTER_AUTH_URL=http://localhost:3001
APP_WEB_ORIGIN=http://localhost:3000    # web app origin (CORS + trusted origin)
BETTER_AUTH_SECRET=change-me-32-bytes-min
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- AI gateway (OpenAI) ---
# The key, the endpoint and the model id must all come from the same vendor.
# Mixing them is not a config error you find quickly: the gateway rejects a key
# it never issued, and the agent answers with nothing at all.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...your-openai-api-key...
AI_MODEL=gpt-4o-mini                    # any model id your key can reach
AI_EMBED_MODEL=                         # optional: gateway embeddings model; empty = local bge-small

# --- Crypto (field-level PII/KYC encryption) ---
FIELD_ENCRYPTION_KEY=base64:generate-a-32-byte-key

# --- Web (public) ---
NEXT_PUBLIC_DATA_MODE=demo              # demo | live
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Observability (optional in dev) ---
SENTRY_DSN=
